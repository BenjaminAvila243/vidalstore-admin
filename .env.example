# Variables de entorno de vidalstore-admin.
# Copia este archivo como .env y completa los valores. El .env real no se sube al repositorio.

# Cognito: identificadores publicos del user pool y del app client de VidalStore
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Broker: conexion AMQP y API HTTP de administracion (Management UI)
RABBITMQ_URL=amqp://USUARIO:CLAVE@localhost:5672
RABBITMQ_API_URL=http://localhost:15672/api
RABBITMQ_USER=USUARIO
RABBITMQ_PASSWORD=CLAVE